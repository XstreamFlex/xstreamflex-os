PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Database Configuration ('sqlite' for local testing, 'mysql' for aihosting.live)
DB_TYPE=sqlite
DB_FILE=database/xmail.sqlite

# MySQL Settings (for aihosting.live)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=xmail_user
MYSQL_PASSWORD=xmail_password
MYSQL_DATABASE=xmail_db

# Default SMTP Relay Settings (Optional Fallback)
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASS=
DEFAULT_FROM_EMAIL=no-reply@xstreamflex.io
DEFAULT_FROM_NAME=XStreamFlex Autoresponder
